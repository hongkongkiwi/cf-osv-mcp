{
  "name": "cf-osv-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Authenticated MCP server for OSV vulnerability lookups on Cloudflare Workers",
  "scripts": {
    "dev": "env -u HTTP_PROXY -u HTTPS_PROXY wrangler dev",
    "deploy": "env -u HTTP_PROXY -u HTTPS_PROXY wrangler deploy",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "env -u HTTP_PROXY -u HTTPS_PROXY pnpm run lint && pnpm run typecheck && pnpm run test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@cloudflare/workers-types": "^5.20261107.1",
    "@types/node": "^22.20.5",
    "typescript": "^5.7.0",
    "vitest": "^4.1.12",
    "wrangler": "^4.152.0"
  },
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24"
  }
}
